    <!-- Welcome / pairing -->
    <string name="welcome_hello">Hi, I\'m Mello.</string>
    <string name="welcome_intro">I\'ll show you around. It takes less than a minute.</string>
    <string name="tour_1_title">A mall of helpers</string>
    <string name="tour_1_body">Helpers are friendly AI assistants. Each one is good at something: writing, studying, planning, money. They live on your own network.</string>
    <string name="tour_2_title">Talk like you text</string>
    <string name="tour_2_body">Write to a helper in your own words, like a text message. You can also chat with people and with groups.</string>
    <string name="tour_3_title">You stay in charge</string>
    <string name="tour_3_body">Helpers never do important things without your OK. You will always see what happens if you say yes, if you say not now, and how to undo.</string>
    <string name="tour_next">Next</string>
    <string name="tour_skip">Skip</string>
