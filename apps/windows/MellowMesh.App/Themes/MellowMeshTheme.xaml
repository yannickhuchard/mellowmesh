<?xml version="1.0" encoding="utf-8"?>
<!--
  "Mesh Mall in daylight" (docs/design/design-language.md v3): paper, one
  strong ink for primary actions, a little color for helpers and meaning.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="PaperColor">#F4F3EF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="InkColor">#111114</Color>
    <Color x:Key="Ink2Color">#55555C</Color>
    <Color x:Key="Ink3Color">#8A8A90</Color>
    <Color x:Key="HairlineColor">#0F111114</Color>
    <Color x:Key="IndigoColor">#4F46E5</Color>
    <Color x:Key="AmberColor">#F59E0B</Color>
    <Color x:Key="AmberTintColor">#FFF6E0</Color>
    <Color x:Key="GreenColor">#10B981</Color>
    <Color x:Key="GreenTintColor">#E7F8F0</Color>
    <Color x:Key="RoseColor">#E11D48</Color>
    <Color x:Key="RoseTintColor">#FFF1F5</Color>
    <Color x:Key="VioletColor">#7C3AED</Color>
    <Color x:Key="SkyColor">#0EA5E9</Color>
    <Color x:Key="PinkColor">#EC4899</Color>

    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Ink2Brush" Color="{StaticResource Ink2Color}" />
    <SolidColorBrush x:Key="Ink3Brush" Color="{StaticResource Ink3Color}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="AmberTintBrush" Color="{StaticResource AmberTintColor}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="GreenTintBrush" Color="{StaticResource GreenTintColor}" />
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="RoseTintBrush" Color="{StaticResource RoseTintColor}" />
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" />

    <!-- Type: large and tight for headlines and numbers, comfortable body. -->
    <Style x:Key="HeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-35" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NumberTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-35" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- Cards: white on paper, hairline, generous radius. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="NeedsYouCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{StaticResource AmberTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AmberBrush}" />
    </Style>

    <Style x:Key="PageRootStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="Padding" Value="32,24,32,24" />
    </Style>

    <!-- XAML allows a dictionary's own items on one side of a property
         element only, so the theme dictionaries close the file. -->
    <!-- Primary actions are black ink (lightweight styling of AccentButtonStyle). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#111114" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2A2A31" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6E6EA" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F4F3EF" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#0F111114" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#111114" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2A2A31" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#000000" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6E6EA" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F4F3EF" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#0F111114" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
